{
  "name": "khe-deals",
  "version": "0.1.0",
  "private": true,
  "description": "Family deal alerts: a Telegram bot that watches second-hand listings and judges them with Claude.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/**/*.test.ts'",
    "check": "npm run -s lint && npm run -s typecheck && npm run -s test",
    "check:watches": "node src/watches.ts",
    "collect": "node src/collect.ts",
    "act": "node src/act.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
